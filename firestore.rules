rules_version = '2';

// All reads and writes go through the Next.js server using the Firebase Admin
// SDK, which bypasses these rules entirely. No client-side Firestore SDK is
// used anywhere in this app, so client access is denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
