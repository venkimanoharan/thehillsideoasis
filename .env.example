# Copy to .env.local for local development.

# --- Firestore ---
# Local dev: point at the emulator instead of setting credentials.
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   FIREBASE_PROJECT_ID=demo-hillsideoasis
#
# Production (Cloud Run): leave these unset and attach a service account with
# the "Cloud Datastore User" role to the Cloud Run service instead — the
# Admin SDK will use Application Default Credentials automatically.
# Only set these if running outside GCP (e.g. another host):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Admin auth (required in production; dev falls back to admin/change-me) ---
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Booking emails (optional; booking still saves without SMTP configured) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# --- Contact defaults (optional; overridable from /admin) ---
PHONE_NUMBER=
